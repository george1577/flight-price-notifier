# Copy to .env.local (git-ignored) for local dev; set the same names in Vercel's env vars.

# Supabase (auth only). Lovable writes these into .env.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Base URL of the flight-api HTTP API (API Gateway), no trailing slash.
# Get it from the `ApiBaseUrl` output of the flight-m1 stack (see infra/README.md).
VITE_FLIGHT_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com
